# Required. Your Postgres connection string.
# For Render Postgres, use the "Internal Database URL" from the database's
# dashboard page when the web service lives in the same Render account/region
# (no SSL needed then — leave PGSSL unset). Use the "External Database URL"
# plus PGSSL=true if connecting from outside Render.
DATABASE_URL=

# Set to "true" only when using an external/public Postgres connection string.
PGSSL=

# Required in production. Generate one with:  openssl rand -hex 48
# If unset in development, the server generates a random one at startup
# (fine for local testing; everyone gets logged out whenever you restart it).
JWT_SECRET=

# Port the server listens on. Defaults to 3001 if unset.
PORT=3001

# Set to "production" in real deployments. This also makes JWT_SECRET mandatory.
NODE_ENV=development

# Only needed if you host the client on a different origin than this API
# (the default setup serves both from this same process, so you can leave
# this unset). Comma-separated list of allowed origins, e.g.:
# CORS_ORIGIN=https://dara.example.com,https://www.dara.example.com
CORS_ORIGIN=
